# General aliases
alias ll='ls -l'
alias la='ls -A'
alias l='ls -CF'

# Git shortcuts
alias gs='git status'
alias gl='git log --oneline --graph --decorate'
alias gp='git pull'
alias gc='git commit -m'
alias gd='git diff'

# Directory navigation
alias ..='cd ..'
alias ...='cd ../..'
alias ~='cd ~'

# History shortcuts
alias h='history'
alias hc='history -c'  # Clear history

# Other utilities
alias py='python3'
alias venv='source venv/bin/activate'

